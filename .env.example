# Postgres (Neon). DATABASE_URL = pooled connection string, DIRECT_URL = direct (unpooled) one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth. Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Public URL of the site (used for sitemap + SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account, created by `npm run setup` (use a long password, 10+ chars)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# Image uploads. On Vercel create a Blob store and paste its token here.
# Leave empty to store uploads on local disk (./uploads, for a VPS/Docker with a persistent volume).
BLOB_READ_WRITE_TOKEN=""
# UPLOAD_DIR="./uploads"
